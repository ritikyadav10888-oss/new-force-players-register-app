# =============================================================================
# Local env template — copy to `.env.local` and fill values
# Production secrets belong only on Vercel, never commit real keys
# =============================================================================
#
# Migration target: Firebase project force-pulse-fa138
# App host stays on Vercel. Data: Cloud SQL Postgres + Firebase Auth + Storage.
# Keep SUPABASE_* until cutover; remove after Firebase path is live.

# -----------------------------------------------------------------------------
# Firebase web (Console → Project settings → Your apps)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=force-pulse-fa138.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=force-pulse-fa138
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=force-pulse-fa138.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Cloud SQL (force-pulse-fa138)
CLOUD_SQL_INSTANCE=force-pulse-fa138:asia-south1:force-pulse-fa138-instance
USE_CLOUD_SQL_CONNECTOR=true
PGUSER=postgres
PGPASSWORD=
PGDATABASE=postgres
# Or direct TCP (Vercel with authorized networks):
# DATABASE_URL=postgresql://postgres:PASSWORD@PUBLIC_IP:5432/postgres

# Server-only Admin SDK JSON path (never commit the file)
FIREBASE_SERVICE_ACCOUNT_PATH=./force-pulse-fa138-firebase-adminsdk-fbsvc-c1901a9640.json
# GOOGLE_APPLICATION_CREDENTIALS=./force-pulse-fa138-firebase-adminsdk-fbsvc-c1901a9640.json

# -----------------------------------------------------------------------------
# Cloud SQL Postgres (same GCP project as Firebase)
# Prefer DATABASE_URL with public IP + SSL for Vercel serverless.
# Example: postgresql://USER:PASSWORD@PUBLIC_IP:5432/force_pulse?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL=
# DATABASE_SSL=false
# DATABASE_POOL_MAX=5
# Or discrete vars instead of DATABASE_URL:
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=force_pulse

# -----------------------------------------------------------------------------
# Supabase (legacy JWT fallback only — remove after Firebase Auth users exist)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# One-time: provision Firebase Auth users from Cloud SQL admin_users
# (preserves UUIDs). Enable Email/Password in Firebase Console first.
# FIREBASE_AUTH_BOOTSTRAP_PASSWORD=change-me-then-run-scripts/provision-firebase-admins.mjs

# -----------------------------------------------------------------------------
# Razorpay (new account keys when you switch)
# Webhook URL: https://<your-vercel-domain>/api/razorpay/webhook
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=

# Optional (legacy Edge Function / internal complete endpoint)
INTERNAL_COMPLETE_SECRET=

# Optional
RESEND_API_KEY=
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=

# Development only (never true in production / Vercel)
ALLOW_DEV_MOCK_PAYMENT=true
