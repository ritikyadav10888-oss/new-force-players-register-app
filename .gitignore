# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# Supabase → Cloud SQL dumps (PII)
/firebase/dumps/

# Firebase Admin SDK service account keys (never commit)
*firebase-adminsdk*.json
**/service-account*.json
firebase/service-account.json

# Local Cloud SQL proxy binary
cloud-sql-proxy.exe
**/cloud-sql-proxy.exe

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI temp
supabase/.temp/